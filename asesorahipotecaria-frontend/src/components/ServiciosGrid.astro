---
import { getCollection } from "astro:content";

const servicios = (await getCollection("servicios")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 text-left">
  {
    servicios.map((servicio) => (
      <a
        href={`/hipotecas/${servicio.slug}/`}
        class="group flex flex-col h-full p-6 rounded-2xl bg-white dark:bg-gray-700 border border-gray-100 dark:border-gray-600 shadow-sm hover:shadow-lg hover:border-blue-500 transition"
      >
        <h3 class="text-xl font-bold group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
          {servicio.data.shortName}
        </h3>
        <p class="mt-2 grow text-gray-600 dark:text-gray-300 leading-relaxed">
          {servicio.data.cardText}
        </p>
        <span class="mt-4 font-semibold text-blue-600 dark:text-blue-400">
          Más información →
        </span>
      </a>
    ))
  }
</div>
